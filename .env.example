# DEEPSEEK
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
GIPHY_API_KEY=
PEXELS_API_KEY=
FREESOUND_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_TEXT_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_APP_TITLE=
# LLM_PROVIDER selects the only JSON LLM provider used when explicitly set.
# Leave it blank for OpenRouter-first with DeepSeek fallback.
LLM_PROVIDER=openrouter
NEXT_PUBLIC_APP_URL=http://localhost:3000
# STORAGE_MODE: "local" (dev) writes to public/generated/ and serves via /generated/*.
# "blob" (Vercel) uploads MP4/poster to Vercel Blob and returns CDN URLs.
# When set to "blob" you MUST also set BLOB_READ_WRITE_TOKEN.
STORAGE_MODE=local
BLOB_READ_WRITE_TOKEN=
